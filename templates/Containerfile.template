FROM {{ base_image }}

ARG SPECIALIST={{ specialist_name }}
ENV HERMES_SPECIALIST=${SPECIALIST}

COPY config.yaml /opt/hermes-init/config.yaml
COPY SOUL.md /opt/hermes-init/SOUL.md

{% if skills %}
COPY skills/ /opt/hermes-init/skills/{{ specialist_name }}/
{% endif %}

{% if context_files %}
COPY context/ /opt/hermes-init/context/
{% endif %}

WORKDIR ${HERMES_HOME}
USER 1001
ENTRYPOINT ["hermes"]
