FROM {{ base_image }}

ARG SPECIALIST={{ specialist_name }}
ENV HERMES_SPECIALIST=${SPECIALIST}

COPY config.yaml ${HERMES_HOME}/config.yaml
COPY SOUL.md ${HERMES_HOME}/SOUL.md

{% if skills %}
COPY skills/ ${HERMES_HOME}/skills/{{ specialist_name }}/
{% endif %}

{% if context_files %}
COPY context/ ${HERMES_HOME}/context/
{% endif %}

WORKDIR ${HERMES_HOME}
USER 1001
ENTRYPOINT ["hermes"]
